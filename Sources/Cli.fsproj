<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>PowerShell cmdlets for common administrative tasks, such as database management, service management and software installation.</Description>
		<Product>Belin CLI</Product>
		<Version>6.1.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Belin.Cli</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<RootNamespace>Belin.Cli</RootNamespace>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
		<PackageReference Update="FSharp.Core" Version="10.1.401" />
		<PackageReference Include="Belin.Sql" Version="5.3.0" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="System.Management.Automation" Version="7.6.6" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="Architecture.fs" />
		<Compile Include="Net.fs" />
		<Compile Include="Security.fs" />
		<Compile Include="Validation.fs" />

		<Compile Include="Compression.fs" />
		<Compile Include="Deployment.fs" />
		<Compile Include="Diagnostics.fs" />
		<Compile Include="InformationSchema.fs" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>Cedric-Belin.fr</Company>
		<Copyright>© Cédric Belin</Copyright>
		<Description>Command line interface for common administrative tasks, such as database management, service management and software installation.</Description>
		<Product>Belin CLI</Product>
		<Version>2026.11.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>CedX</Authors>
		<IncludeSymbols>true</IncludeSymbols>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageTags>TODO</PackageTags>
		<PackAsTool>true</PackAsTool>
		<RepositoryUrl>https://github.com/CedX/Cli.git</RepositoryUrl>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<AssemblyName>Belin.Cli</AssemblyName>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<OutputType>Exe</OutputType>
		<RootNamespace>Belin.Cli</RootNamespace>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<TargetFramework>net11.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
		<PackageReference Update="FSharp.Core" Version="11.0.101" />
		<PackageReference Include="Belin.Sql.FSharp" Version="2026.12.1" />
		<PackageReference Include="Belin.Which.FSharp" Version="2026.11.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="MySqlConnector" Version="3.0.0" />
		<PackageReference Include="System.CommandLine" Version="3.0.0" />
		<PackageReference Include="System.ServiceProcess.ServiceController" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- <Compile Include="Data.fs" />
		<Compile Include="Diagnostics.fs" />
		<Compile Include="IO.fs" />
		<Compile Include="Management.fs" />
		<Compile Include="Net.fs" />
		<Compile Include="Security.fs" />
		<Compile Include="ServiceProcess.fs" />
		<Compile Include="Text.fs" />
		<Compile Include="Validation.fs" />
		<Compile Include="Services/DotNet.fs" />
		<Compile Include="Services/Node.fs" />
		<Compile Include="Services/PowerShell.fs" />
		<Compile Include="Services/Factory.fs" />
		<Compile Include="Cmdlets/*.fs" /> -->
		<Compile Include="RootCommand.fs" />
		<Compile Include="Container.fs" />
		<Compile Include="Program.fs" />
		<Content Include="../Resources/**" CopyToOutputDirectory="Always" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
